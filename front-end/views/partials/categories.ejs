<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="text-start text-light m-0">Categories </h1>
        <h5 class="text-white m-0" style="--bs-text-opacity: .3;">Manage categories</h5>
        <button class="createButton text-light ms-auto" data-bs-toggle="modal" data-bs-target="#createCategory">Create
            <svg class="bin" xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
            fill="#ffffff" viewBox="0 0 24 24" >
            <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
            <path d="M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4z"></path><path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2m0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8"></path>
            </svg>
        </button>
    </div>

        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover table-bordered align-middle text-center shadow-lg">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Name</th>
                        <th scope="col">Deleted</th>
                        <th scope="col">Option</th>
                    </tr>
                </thead>
                    <tbody>
                        <% categories.forEach(category => { %>
                        <tr>
                            <td><%= category.id %></td>
                            <td><%= category.name %></td>
                            <td class="text-center align-middle text-success">
                                <% if (category.is_deleted) { %>
                                    <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                                    fill="currentColor" viewBox="2 2 20 20" >
                                    <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                    <path d="M9 15.59 4.71 11.3 3.3 12.71l5 5c.2.2.45.29.71.29s.51-.1.71-.29l11-11-1.41-1.41L9.02 15.59Z"></path>
                                    </svg>
                                <% } %>
                            </td>
                            <td class="text-center align-middle">
                                <div class="d-flex justify-content-center gap-2">
                                    <% if (!category.is_deleted) { %> 
                                        <form action="/categories/<%= category.id %>/delete" method="POST">
                                            <button class="deleteButton">
                                                    <svg class="bin" xmlns="http://www.w3.org/2000/svg" width="512" height="512"  
                                                    fill="#ffffff" viewBox="0 0 24 24" >
                                                    <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                                    <path d="M17 6V4c0-1.1-.9-2-2-2H9c-1.1 0-2 .9-2 2v2H2v2h2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8h2V6zM9 4h6v2H9zM6 20V8h12v12z"></path><path d="M9 10h2v8H9zm4 0h2v8h-2z"></path>
                                                    </svg>
                                                <span class="tooltip">Delete</span>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/categories/<%= category.id %>/restore" method="POST">
                                            <button class="restoreButton">
                                                <svg  xmlns="http://www.w3.org/2000/svg" width="512" height="512"  
                                                fill="#ffffff" viewBox="0 0 24 24" >
                                                <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                                <path d="M9 20h3v-2H9c-2.21 0-4-1.79-4-4s1.79-4 4-4h6v4l6-5-6-5v4H9c-3.31 0-6 2.69-6 6s2.69 6 6 6"></path>
                                                </svg>
                                            <span class="tooltip">Restore</span>
                                            </button>
                                        </form>
                                    <% } %>
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="editButton" data-bs-toggle="modal" data-bs-target="#editCategory<%= category.id %>">
                                        <svg  xmlns="http://www.w3.org/2000/svg" width="512" height="512"  
                                        fill="#ffffff" viewBox="0 0 24 24" >
                                        <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                        <path d="M19.67 2.61c-.81-.81-2.14-.81-2.95 0L3.38 15.95c-.13.13-.22.29-.26.46l-1.09 4.34c-.08.34.01.7.26.95.19.19.45.29.71.29.08 0 .16 0 .24-.03l4.34-1.09c.18-.04.34-.13.46-.26L21.38 7.27c.81-.81.81-2.14 0-2.95L19.66 2.6ZM6.83 19.01l-2.46.61.61-2.46 9.96-9.94 1.84 1.84zM19.98 5.86 18.2 7.64 16.36 5.8l1.78-1.78s.09-.03.12 0l1.72 1.72s.03.09 0 .12"></path>
                                        </svg>
                                    <span class="tooltip">Edit</span>
                                    </button>
                                    </div>
                                </div>
                            </td>
                        </tr>

                    <div class="modal fade" id="editCategory<%= category.id %>">
                        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content bg-dark border-secondary">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5 text-light">Edit Category</h1>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form action="/categories/<%= category.id %>/update" method="POST">
                                    <div class="mb-3">
                                    <label for="categoryName" class="form-label text-light">Name</label>
                                    <input type="text" id="categoryName" name="name" class="form-control bg-dark text-light border-secondary" required>
                                    </div>
                                    <div class="modal-footer border-secondary">
                                        <button type="button" class="cancelButton me-auto" data-bs-dismiss="modal">
                                            <span>Cancel</span>
                                            <span></span>
                                        </button>
                                        <button type="submit" class="modal-submitButton">
                                            <span>Submit</span>
                                            <span></span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                            </div>
                        </div>
                    </div>

                <% }) %>

                    <div class="modal fade" id="createCategory">
                        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content bg-dark border-secondary">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5 text-light">Create Category</h1>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form action="/categories/create" method="POST">
                                <div class="mb-3">
                                    <label for="categoryName" class="form-label text-light">Name</label>
                                    <input type="text" id="categoryName" name="name" class="form-control bg-dark text-light border-secondary">
                                </div>
                            </div>
                                    <div class="modal-footer border-secondary">
                                        <button type="button" class="cancelButton me-auto" data-bs-dismiss="modal">
                                            <span>Cancel</span>
                                            <span></span>
                                        </button>
                                        <button type="submit" class="modal-submitButton">
                                            <span>Submit</span>
                                            <span></span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                            </div>
                        </div>
                    </div>
                    </tbody>
            </table>
        </div>
</div>