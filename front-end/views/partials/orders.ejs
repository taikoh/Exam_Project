<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="text-start text-light m-0">Orders </h1>
        <h5 class="text-white m-0" style="--bs-text-opacity: .3;">Manage orders</h5>
    </div>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover table-bordered align-middle text-center shadow-lg">
                <thead>
                    <tr>
                        <th scope="col">Order Number</th>
                        <th scope="col">Name</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Price</th>
                        <th scope="col">Discount</th>
                        <th scope="col">Total Price</th>
                        <th scope="col">Status</th>
                        <th scope="col">Edit</th>
                    </tr>
                </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                        <tr>
                            <td><%= order.order_number %></td>
                            <td><% order.OrderItems.forEach(item => { %>
                                    <%= item.Product.name %>
                            </td>
                            <td><%= item.quantity %></td>
                            <td><%= item.price %></td>
                                <% }) %>
                            <td><%= order.discount_amount %></td>
                            <td><%= order.final_total %></td>
                            <td><%= order.status %></td>
                            <td class="align-middle">
                                <div class="d-flex justify-content-center">
                                    <button class="editButton" data-bs-toggle="modal" data-bs-target="#editOrder<%= order.id %>">
                                        <svg  xmlns="http://www.w3.org/2000/svg" width="512" height="512"  
                                        fill="#ffffff" viewBox="0 0 24 24" >
                                        <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                        <path d="M19.67 2.61c-.81-.81-2.14-.81-2.95 0L3.38 15.95c-.13.13-.22.29-.26.46l-1.09 4.34c-.08.34.01.7.26.95.19.19.45.29.71.29.08 0 .16 0 .24-.03l4.34-1.09c.18-.04.34-.13.46-.26L21.38 7.27c.81-.81.81-2.14 0-2.95L19.66 2.6ZM6.83 19.01l-2.46.61.61-2.46 9.96-9.94 1.84 1.84zM19.98 5.86 18.2 7.64 16.36 5.8l1.78-1.78s.09-.03.12 0l1.72 1.72s.03.09 0 .12"></path>
                                        </svg>
                                    <span class="tooltip">Edit</span>
                                    </button>
                                </div>
                            </td>
                        </tr>

                    <div class="modal fade" id="editOrder<%= order.id %>">
                        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content bg-dark border-secondary">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5 text-light">Edit Order</h1>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form action="/orders/<%= order.id %>/update" method="POST">
                                    <div class="mb-3">
                                    <label for="orderSelect" class="form-label text-light">Status</label>
                                    <select id="orderSelect" name="status" class="form-select bg-dark text-light border-secondary"> 
                                        <option selected>In Progress</option>
                                        <option>Ordered</option>
                                        <option>Completed</option>
                                    </select>
                                    </div>
                                    <div class="modal-footer border-secondary">
                                        <button type="button" class="cancelButton me-auto" data-bs-dismiss="modal">
                                            <span>Cancel</span>
                                            <span></span>
                                        </button>
                                        <button type="submit" class="modal-submitButton">
                                            <span>Submit</span>
                                            <span></span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                            </div>
                        </div>
                    </div>

                    <% }) %>
                    </tbody>
            </table>
        </div>
    </div>